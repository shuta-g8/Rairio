{
  "name": "rairio",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "data:refresh": "node scripts/fetch-toei-timetables.mjs",
    "data:journey": "node scripts/prepare-journey-data.mjs",
    "data:kanto": "node scripts/prepare-kanto-network.mjs",
    "data:directory": "node scripts/generate-station-directory.mjs",
    "data:holidays": "node scripts/generate-holiday-dates.mjs",
    "check:quick": "npm run licenses:check && npm run format:check && npm test"
  },
  "dependencies": {
    "@fontsource/line-seed-jp": "^5.3.2",
    "@holiday-jp/holiday_jp": "^2.5.2",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
